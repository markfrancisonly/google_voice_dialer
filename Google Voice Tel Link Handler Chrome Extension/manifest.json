{
  "manifest_version": 3,
  "name": "Google Voice Tel Link Opener",
  "version": "1.0.0",
  "description": "Intercepts tel: links and opens them in a new popup window using Google Voice instead of the native dialer.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://voice.google.com/*"
  ],
  "action": {
    "default_title": "Open Google Voice",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
